# =============================================================
# TRANSITFLOW TMS - ENVIRONMENT CONFIGURATION (.env)
# =============================================================
# Any values defined in .env will act as the "BOSS" and take 
# highest priority over default configuration in both local 
# and production environments.
# =============================================================

# 1. FRONTEND CONFIGURATION (apps/web-admin/.env.local)
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:5063/api
# For production (set on Vercel dashboard):
# NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5063/api

# 2. BACKEND DATABASE CONNECTION (apps/api-backend)
# Priority: DATABASE_URL / DB_CONNECTION -> DefaultConnection (Neon) -> LocalConnection (Localhost)
# Local PostgreSQL:
# DB_CONNECTION=Host=localhost;Database=TMSSAAS;Username=postgres;Password=123423
# Neon Cloud PostgreSQL (AWS):
DB_CONNECTION=Host=ep-jolly-tree-azqizbzw.c-3.ap-southeast-1.aws.neon.tech;Database=TMSSAAS;Username=neondb_owner;Password=npg_WatBILvcEq01;Ssl Mode=Require;Trust Server Certificate=true;

# 3. BACKEND FRONTEND URL (For WhatsApp Links sent to Drivers, Vendors & Customers)
# For local development:
# FRONTEND_BASE_URL=http://localhost:3000
# For production:
FRONTEND_BASE_URL=https://tms-saas-product.vercel.app

