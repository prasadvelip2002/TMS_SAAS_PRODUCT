# =============================================================
# LOGIPULSE TMS - ENVIRONMENT CONFIGURATION (.env)
# =============================================================
# Environment variables take highest priority over appsettings.json
# in both local development and production (Render / Vercel).
# =============================================================

# 1. FRONTEND CONFIGURATION (Vercel Environment Variables / apps/web-admin/.env.local)
# Local:      NEXT_PUBLIC_API_URL=http://localhost:5063/api
# Production: NEXT_PUBLIC_API_URL=https://tms-saas-product.onrender.com/api
NEXT_PUBLIC_API_URL=https://tms-saas-product.onrender.com/api

# 2. BACKEND DATABASE CONNECTION (Render Environment Variables)
# Priority: DATABASE_URL -> DB_CONNECTION -> DefaultConnection
DB_CONNECTION=Host=YOUR_NEON_HOST;Database=TMSSAAS;Username=neondb_owner;Password=YOUR_DB_PASSWORD;Ssl Mode=Require;Trust Server Certificate=true;

# 3. BACKEND JWT SIGNING KEY (Use a strong 32+ char secret in production)
JWT_KEY=CHANGE_ME_TO_STRONG_PRODUCTION_SECRET_KEY

# 4. BACKEND FRONTEND URL (Used in WhatsApp links for Drivers, Vendors & Customers)
FRONTEND_BASE_URL=https://tms-saas-product.vercel.app

# 5. META WHATSAPP CLOUD API (Set in Render Environment Variables — NEVER commit real tokens!)
WHATSAPP_PHONE_NUMBER_ID=1417603178092221
WHATSAPP_BUSINESS_NUMBER=+91 93847 12208
WHATSAPP_ACCESS_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN

# 6. DOTMOVE TELECOM SIM LBS TRACKING (Optional — runs in sandbox simulation mode if blank)
DOTMOVE_BASE_URL=https://api.dotmove.in
DOTMOVE_API_KEY=
